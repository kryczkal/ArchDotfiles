#!/bin/bash
# install — fresh Arch (base + user with sudo + network) -> this environment.
# Idempotent: run it again any time, it only changes what differs. No prompts
# except sudo's password.
#   ./install          everything: etc/, packages, dotfiles, services
#   ./install --keys   one-off: ssh key
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
host=$(</etc/hostname)
say() { printf '\n\033[1;34m== %s\033[0m\n' "$*"; }
pkgs() { sed 's/#.*//' "$@" 2>/dev/null | tr -s ' \n' '\n' | grep -v '^$'; }

if [[ ${1:-} == --keys ]]; then
  [[ -f ~/.ssh/id_ed25519 ]] || ssh-keygen -t ed25519 -C "$USER@$host"
  echo "public key (add to GitHub):"; cat ~/.ssh/id_ed25519.pub
  exit 0
fi

say "etc/ -> /etc"
sudo sed -i 's/^#\(Color\|ParallelDownloads\|VerbosePkgLists\)/\1/' /etc/pacman.conf
(cd etc && find . -type f ! -name .driftignore | while read -r f; do
  mode=644; [[ $f == ./sudoers.d/* ]] && mode=440
  sudo install -CDm"$mode" "$f" "/etc/${f#./}"
done)
if ! locale -a | grep -qi 'pl_PL.utf8'; then
  sudo sed -i 's/^#\(en_US.UTF-8\|pl_PL.UTF-8\) UTF-8/\1 UTF-8/' /etc/locale.gen && sudo locale-gen
fi

say "packages: pacman"
sudo pacman -Syu --needed --noconfirm $(pkgs pkgs/base.txt pkgs/desktop.txt "pkgs/host-$host.txt")

say "packages: aur"
if ! command -v paru >/dev/null; then
  tmp=$(mktemp -d)
  # source build: paru-bin on AUR lags libalpm bumps. -r drops rust afterwards.
  git clone -q https://aur.archlinux.org/paru.git "$tmp" && (cd "$tmp" && makepkg -sir --noconfirm)
  rm -rf "$tmp"
fi
paru -S --needed --noconfirm $(pkgs pkgs/aur.txt)

say "dotfiles: stow home/common + home/host-$host (repo wins, conflicts -> *.pre-stow)"
for f in .bashrc .bash_profile .bash_logout; do   # /etc/skel leftovers, zsh only here
  [[ -f ~/$f ]] && cmp -s ~/"$f" /etc/skel/"$f" && rm ~/"$f"
done
stow_pkg() {
  { stow -n -t ~ "$1" 2>&1 || true; } |
    sed -n 's/.*existing target \(.*\) since neither a link nor a directory.*/\1/p' |
    while read -r t; do [[ -e ~/$t ]] && mv -v ~/"$t" ~/"$t.pre-stow"; done
  stow -Rt ~ "$1"
}
(cd home && stow_pkg common && { [[ -d host-$host ]] && stow_pkg "host-$host" || true; })
# home/seed: copied once, never overwritten. For files apps rewrite in place
# (atomic rename would replace a symlink with a real file).
(cd home/seed && find . -type f | while read -r f; do
  [[ -e ~/${f#./} ]] || install -Dm644 -v "$f" ~/"${f#./}"
done)

# one-time moves for state that env.sh now routes elsewhere
mv_once() { [[ -e $1 && ! -e $2 ]] && { mkdir -p "$(dirname "$2")"; mv -v "$1" "$2"; }; return 0; }
mv_once ~/.zsh_history ~/.local/state/zsh/history
mv_once ~/.cargo ~/.local/share/cargo
mv_once ~/.npmrc ~/.config/npm/npmrc
mv_once ~/.docker ~/.config/docker
mv_once ~/.aws ~/.config/aws
mv_once ~/go ~/.local/share/go

say "services + shell"
sudo systemctl enable -q --now NetworkManager bluetooth fstrim.timer systemd-timesyncd tlp
sudo systemctl mask -q systemd-rfkill.service systemd-rfkill.socket   # tlp handles rfkill
pacman -Q thermald &>/dev/null && sudo systemctl enable -q --now thermald
systemctl --user enable -q gcr-ssh-agent.socket gnome-keyring-daemon.socket
[[ $(getent passwd "$USER" | cut -d: -f7) == */zsh ]] || chsh -s /usr/bin/zsh

say "done. next: './install --keys', then 'dots drift' and 'dots pkgs' to see what the repo does not own."
