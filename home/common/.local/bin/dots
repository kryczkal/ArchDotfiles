#!/bin/bash
# dots — the dotfiles repo from anywhere.
#   dots <git args>   git inside the repo            (dots status, dots diff)
#   dots sync         stage all, commit with a summary, push
#   dots drift        config on this machine the repo does not own
#   dots pkgs         explicitly installed packages not listed in pkgs/*.txt
#   dots ignore P...  add paths (globs ok) to home/.driftignore
set -euo pipefail
shopt -s nullglob
repo=${DOTFILES:-$HOME/ArchDotfiles}
pkgs() { (cd "$repo/home" && printf '%s\n' common seed host-*); }   # stow packages + seed

case ${1:-} in
sync)
  cd "$repo"
  n=$(git status --porcelain | wc -l)
  (( n )) || { echo "dots: nothing to commit"; exit 0; }
  summary=$(git status --porcelain | awk '{print $NF}' | cut -d/ -f1-3 | sort -u | head -4 | paste -sd, - | sed 's/,/, /g')
  git add -A && git commit -qm "sync($(</etc/hostname)): $n file(s): $summary" && git push -q && echo "pushed: $n file(s)"
  echo "drift: $("$0" drift 2>/dev/null | grep -c '^  ') unmanaged path(s), see 'dots drift'"
  ;;
drift)
  # Two passes, both directions. A path is managed iff the repo ships it.
  #   repo -> machine: every shipped file must be linked (stow) or present (seed)
  #   machine -> repo: every real file in the scanned roots is owned, ignored, or drift
  # Scanned roots: top-level dotfiles in ~ (not dirs: those are app state),
  # ~/.config/** and ~/.local/bin/* (shell scripts only, pip/npm shims skipped).
  shipped() { (cd "$repo/home" && find $(pkgs) -type f ! -name .gitignore | cut -d/ -f2-) | sort -u; }
  owned() { local d; for d in $(pkgs); do [[ -e $repo/home/$d/$1 ]] && return 0; done; return 1; }
  prune=(); while read -r pat; do [[ -n $pat && $pat != \#* ]] && prune+=(-path ~/"$pat" -o); done < "$repo/home/.driftignore"
  echo "## HOME"
  shipped | while read -r rel; do
    if [[ -e $repo/home/seed/$rel ]]; then [[ -e ~/$rel ]] || echo "  $rel  (seed missing, run install)"
    else [[ -L ~/$rel ]] || echo "  $rel  (not linked, run install)"; fi
  done
  { find ~ -mindepth 1 -maxdepth 1 -type f -name '.*' \( "${prune[@]}" -false \) -prune -o -type f -name '.*' -print
    find ~/.config ~/.local/bin \( "${prune[@]}" -false \) -prune -o -type f -print; } | sort |
  while read -r f; do
    rel=${f#"$HOME"/}
    owned "$rel" && continue
    [[ $rel == .local/bin/* ]] && ! head -1 "$f" | grep -qE '^#!.*\b(ba|z)?sh\b' && continue
    echo "  $rel"
  done
  echo "## ETC"
  (cd "$repo/etc" && find . -type f ! -name .driftignore | cut -c3-) | while read -r rel; do
    cmp -s "$repo/etc/$rel" "/etc/$rel" || echo "  /etc/$rel  (differs from repo, run install or copy back)"
  done
  { pacman -Qii 2>/dev/null | grep -oE '/etc/\S+ \[modified\]' | cut -d' ' -f1
    comm -23 <(sudo find /etc -type f | sort) <(pacman -Qlq | grep '^/etc/' | sort); } | sort -u |
  while read -r f; do
    [[ -e $repo/etc/${f#/etc/} ]] && continue
    skip=0; while read -r pat; do [[ -n $pat && $pat != \#* && $f == $pat ]] && { skip=1; break; }; done < "$repo/etc/.driftignore"
    (( skip )) || echo "  $f"
  done
  ;;
ignore)
  shift; printf '%s\n' "$@" >> "$repo/home/.driftignore"; sort -u -o "$repo/home/.driftignore" "$repo/home/.driftignore"
  ;;
pkgs)
  comm -23 <(pacman -Qqe | sort) <(sed 's/#.*//' "$repo"/pkgs/*.txt | tr -s ' \n' '\n' | grep -v '^$' | sort -u)
  ;;
*)
  git -C "$repo" "$@"
  ;;
esac
