#!/bin/bash
# dots — the dotfiles repo from anywhere.
#   dots <git args>   git inside the repo            (dots status, dots diff)
#   dots sync         stage all, commit with a summary, push
#   dots drift        config on this machine the repo does not own
#   dots pkgs         explicitly installed packages not listed in pkgs/*.txt
#   dots ignore P...  add paths (globs ok) to home/.driftignore
set -euo pipefail
repo=${DOTFILES:-$HOME/ArchDotfiles}

case ${1:-} in
sync)
  cd "$repo"
  n=$(git status --porcelain | wc -l)
  (( n )) || { echo "dots: nothing to commit"; exit 0; }
  summary=$(git status --porcelain | awk '{print $NF}' | cut -d/ -f1-3 | sort -u | head -4 | paste -sd, - | sed 's/,/, /g')
  git add -A && git commit -qm "sync($(</etc/hostname)): $n file(s): $summary" && git push -q && echo "pushed: $n file(s)"
  ;;
drift)
  echo "## HOME: real files where the repo is not the owner (add app state to home/.driftignore)"
  ign="$repo/home/.driftignore"
  # ~ top level: files only (dot-dirs there are app state). ~/.config: files and dirs.
  for p in ~/.[!.]* ~/.config/* ~/.local/bin/*; do
    [[ -e $p && ! -L $p ]] || continue
    rel=${p#"$HOME"/}
    [[ $rel != */* && -d $p ]] && continue
    ignored=0; while read -r pat; do [[ -n $pat && $rel == $pat ]] && { ignored=1; break; }; done < "$ign"
    (( ignored )) && continue
    [[ $rel == .local/bin/* && -f $p ]] && ! head -1 "$p" | grep -qE '^#!.*\b(ba|z)?sh\b' && continue  # pip/npm shims
    echo "  $rel"
  done
  ign="$repo/etc/.driftignore"
  etc_filter() {  # drop paths in etc/.driftignore (globs) or present in repo etc/
    while read -r f; do
      [[ -e $repo/etc/${f#/etc/} ]] && continue
      skip=0; while read -r pat; do [[ -n $pat && $f == $pat ]] && { skip=1; break; }; done < "$ign"
      (( skip )) || echo "  $f"
    done
  }
  echo "## ETC: package files modified by hand, not in etc/ (globs in etc/.driftignore)"
  pacman -Qii 2>/dev/null | grep -oE '/etc/\S+ \[modified\]' | cut -d' ' -f1 | etc_filter
  echo "## ETC: files no package owns, not in etc/"
  comm -23 <(sudo find /etc -type f | sort) <(pacman -Qlq | grep '^/etc/' | sort) | etc_filter
  ;;
ignore)
  shift; printf '%s\n' "$@" >> "$repo/home/.driftignore"; sort -u -o "$repo/home/.driftignore" "$repo/home/.driftignore"
  ;;
pkgs)
  comm -23 <(pacman -Qqe | sort) <(sed 's/#.*//' "$repo"/pkgs/*.txt | tr -s ' \n' '\n' | grep -v '^$' | sort -u)
  ;;
*)
  git -C "$repo" "$@"
  ;;
esac
